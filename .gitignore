# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.uv-cache/

# Model caches (downloaded at install/runtime from ModelScope) — never commit.
# Models are fetched by install.ps1 (ModelManager) so the repo stays small.
# The single documented exception (qfuxa streaming tower) is also runtime-fetched.
models/
.modelscope_cache/
.hf_home/

# App data (never commit)
recordings/
sessions/
transcripts/
logs/
user_settings.json
config.json
*.wav
*.mp3

# Local staging / scratch (never commit)
_dl/
tmp/
*:memory:*

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Test / local venv
.pytest_cache/
.venvtest/
tests/screenshots/
tests/demo_shots/
tests/video_frames/
tests/e2e_demo.mp4
# Generated TTS audio (regenerable via tests/make_*.py) — keep repo small.
# script.txt (原文) is kept tracked so recognition can be judged offline.
tests/fixtures/*/*.wav
tests/fixtures/*/*.mp3

# Agent state
.dsh-state.md
